# Copy to .env.local and fill in.

# Neon Postgres. Use the POOLED connection string from the Neon dashboard.
# The site should read with a role that only has SELECT on the content tables.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/reviewkit?sslmode=require"

# Admin/migration connection (owner role). Used by db:migrate and content:import only.
DATABASE_URL_ADMIN="postgresql://owner:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/reviewkit?sslmode=require"

# Where content is read from at build/request time:
#   neon  - query Postgres (production)
#   files - read content/*.json straight off disk (local dev, CI, and the default
#           when DATABASE_URL is not set, so the build never needs a database)
CONTENT_SOURCE="files"

# Public site URL, used for canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for POST /api/revalidate so you can refresh pages after an import.
REVALIDATE_SECRET="change-me"

# The writing studio at /studio. One admin; there is no sign-up.
# Pick your own login id and a long password (12+ characters). Never commit .env.local.
ADMIN_USERNAME="your-login-id"
ADMIN_PASSWORD="change-me-to-something-long"
# Optional: signs the session cookie. Leave unset to derive it from the password,
# so changing the password signs every session out.
# ADMIN_SESSION_SECRET=""
# The studio runs under `npm run dev`. Set this to run it on the live site too. On
# Vercel it only switches on with CONTENT_SOURCE="neon", since the disk is read-only.
# STUDIO_ENABLED="true"

# Optional: Vercel Blob store for studio uploads on a serverless host. Added for you
# when you connect a Blob store to the Vercel project. Unset = save to public/images.
# BLOB_READ_WRITE_TOKEN=""

# Optional: Claude API key for the "Check with Claude" writing check in the editor.
# Create one at https://console.anthropic.com/ (Settings > API keys). It is only used
# on the server, never sent to the browser. Leave unset to use the quick check only.
# ANTHROPIC_API_KEY=""
# Optional: which Claude model the check uses.
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: the model the studio Assistant uses.
# ANTHROPIC_ASSISTANT_MODEL="claude-opus-5-5"
# Needed only if your API key is not scoped to one workspace: the workspace ID
# (starts wrkspc_) from console.anthropic.com under Workspaces.
# ANTHROPIC_WORKSPACE_ID=""
